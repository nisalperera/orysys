# TEMPLATE ONLY: fill required values before starting. Never overwrite a working .env.
# Supported example topology: one hosted OpenAI-compatible endpoint supporting
# BOTH the selected chat model and embedding model. A local gateway may also
# provide both APIs; independent endpoint settings are not implemented.
BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# Choose a chat model actually supported by the configured provider.
LLM_MODEL=REPLACE_WITH_SUPPORTED_CHAT_MODEL
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2

# Match the model/dimensions used to populate your Pinecone index.
# 4096 is an EXAMPLE dimension, not a migration instruction.
EMBEDDING_MODEL=REPLACE_WITH_INDEXED_EMBEDDING_MODEL
EMBEDDING_DIM=4096
EMBEDDING_QUERY_INSTRUCTION=Given a user question about bank internal documents, retrieve relevant passages

# Pinecone: existing index and matching corpus/artifacts.
PINECONE_API_KEY=
PINECONE_INDEX=bank-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
DOCS_DIR=data/docs
BM25_PARAMS_PATH=data/bm25_params.json

# Use the endpoint matching your LangSmith workspace region.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orysys

# Limits: ordinary tool timeout; research has a separate longer limit.
HYBRID_ALPHA=0.6
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=0.5
TOOL_TIMEOUT_SEC=15
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_MAX_PER_DOC=2
EMBEDDING_CACHE_SIZE=256

# Local UI. Compose overrides this with http://api:8000.
UI_API_BASE_URL=http://127.0.0.1:8000
UI_VIEWER_API_KEY=dev-viewer-key
UI_ANALYST_API_KEY=dev-analyst-key
UI_ADMIN_API_KEY=dev-admin-key

# Host-run models inside Docker: use host.docker.internal and an actually
# reachable host port, not container localhost. API host port 8000 is reserved.
# A single vLLM server hosting only chat does not automatically serve embeddings.
