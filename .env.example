# Both Embeddings and LLM
BASE_URL=http://localhost:8000/v1
API_KEY=EMPTY

# LLM
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2

# Embeddings: second local vLLM server
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_QUERY_INSTRUCTION=Given a user question about bank internal documents, retrieve relevant passages

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=bank-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LangSmith (mandatory tracing)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=<api key>
LANGSMITH_AGENT_ID=orysys
LANGSMITH_AGENT_ENVIRONMENT=local

# Retrieval and limits
HYBRID_ALPHA=0.6
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=0.5
TOOL_TIMEOUT_SEC=15

# Retrieval and Embedding Settings
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_MAX_PER_DOC=2
EMBEDDING_CACHE_SIZE=256
